{
  "name": "netvision-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test:email": "ts-node scripts/test-email.ts",
    "test:email:suite": "ts-node scripts/test-email-suite.ts",
    "test:beta:auth": "ts-node scripts/test-beta-auth.ts",
    "test:deployment": "ts-node scripts/test-deployment-readiness.ts",
    "test:troubleshooting": "ts-node scripts/test-network-troubleshooting-engine.ts",
    "test:security": "ts-node scripts/test-oauth-otp-security.ts",
    "test:claim:security": "ts-node scripts/test-anonymous-claim-security.ts",
    "test:monitoring": "ts-node scripts/test-monitoring-observability.ts",
    "test:ipv6": "ts-node scripts/test-ipv6-curriculum.ts",
    "test:ospf:multi-area": "ts-node scripts/test-multi-area-ospf.ts",
    "test:network-automation": "ts-node scripts/test-network-automation.ts",
    "test:curriculum:content-v2": "ts-node scripts/test-curriculum-content-v2.ts",
    "test:troubleshooting:flow": "ts-node scripts/test-troubleshooting-catalog-flow.ts",
    "test:product:correctness": "ts-node scripts/test-product-correctness.ts",
    "test:all": "ts-node scripts/test-oauth-otp-security.ts && ts-node scripts/test-anonymous-claim-security.ts && ts-node scripts/test-monitoring-observability.ts && ts-node scripts/test-email-suite.ts && ts-node scripts/test-deployment-readiness.ts && ts-node scripts/test-network-troubleshooting-engine.ts && ts-node scripts/test-troubleshooting-catalog-flow.ts && ts-node scripts/test-beta-auth.ts && ts-node scripts/test-product-correctness.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@netvision/shared": "workspace:*",
    "@prisma/client": "^5.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.19.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.2",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.15.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
