generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseLevel {
  FOUNDATIONAL
  BEGINNER
  INTERMEDIATE
  SECURITY
  ADVANCED
  EXPERT
}

enum LessonType {
  THEORY
  ANIMATION
  INTERACTIVE_SIMULATION
  SANDBOX_LAB
  QUIZ
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  username     String         @unique
  passwordHash String?
  fullName     String?
  role         Role           @default(STUDENT)
  avatarUrl    String?
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  progress      UserProgress[]
  savedLessons  SavedLesson[]
  certificates  Certificate[]
  achievements  UserAchievement[]
  simulations   SimulationState[]
  quizAttempts  QuizAttempt[]
  oauthAccounts OAuthAccount[]
  labAttempts   LabAttempt[]
  sandboxSessions SandboxSession[]

  @@map("users")
}

model Course {
  id             String       @id @default(uuid())
  slug           String       @unique
  title          String
  tagline        String
  category       String       @default("Fundamentals")
  description    String
  level          CourseLevel  @default(BEGINNER)
  icon           String
  estimatedHours Int          @default(5)
  published      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modules        Module[]
  certificates   Certificate[]

  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
  @@map("modules")
}

enum LabType {
  GUIDED
  ASSISTED
  CHALLENGE
  TROUBLESHOOTING_INCIDENT
}

model Lesson {
  id                   String            @id @default(uuid())
  moduleId             String
  title                String
  slug                 String            @unique
  type                 LessonType        @default(THEORY)
  durationMinutes      Int               @default(15)
  order                Int
  contentJson          Json?
  introduction         String?
  simpleExplanation    String?
  analogy              String?
  technicalExplanation String?
  cheatsheetJson       Json?
  visualizationType    String?
  masteryScoreRequired Int               @default(80)
  createdAt            DateTime          @default(now())

  module               Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes              Quiz[]
  userProgress         UserProgress[]
  savedBy              SavedLesson[]
  objectives           LessonObjective[]
  concepts             LessonConcept[]
  examples             LessonExample[]
  commands             LessonCommand[]
  labs                 LessonLab[]
  mistakes             LessonMistake[]
  recaps               LessonRecap[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonObjective {
  id        String   @id @default(uuid())
  lessonId  String
  text      String
  order     Int      @default(0)

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_objectives")
}

model LessonConcept {
  id               String   @id @default(uuid())
  lessonId         String
  title            String
  summary          String
  explanation      String?
  technicalDetails String?
  order            Int      @default(0)

  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_concepts")
}

model LessonExample {
  id          String   @id @default(uuid())
  lessonId    String
  title       String
  scenario    String
  explanation String
  order       Int      @default(0)

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_examples")
}

model LessonCommand {
  id            String   @id @default(uuid())
  lessonId      String
  command       String
  description   String
  exampleOutput String?
  category      String?  @default("General")
  order         Int      @default(0)

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_commands")
}

model LessonLab {
  id                       String       @id @default(uuid())
  lessonId                 String
  slug                     String?      @unique
  type                     LabType      @default(GUIDED)
  title                    String
  description              String?
  difficulty               CourseLevel  @default(BEGINNER)
  estimatedMinutes         Int          @default(15)
  objectivesJson           Json?        // Array of objective strings
  prerequisitesJson        Json?        // Array of prerequisite slugs
  environmentJson          Json?        // Initial topology and device configuration state
  instructions             String
  commandsJson             Json?        // Predefined allowed commands and output matchers
  expectedObservationsJson Json?        // Expected outputs/telemetry
  hintsJson                Json?        // Progressive hint strings
  validationRulesJson      Json?        // Target state checks and regex rules
  solutionJson             Json?        // Step-by-step solution guide
  commonMistakesJson       Json?        // Pitfalls & troubleshooting tips
  completionCriteria       String?
  initialTopologyJson      Json?
  targetStateJson          Json?
  order                    Int          @default(0)

  lesson                   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts                 LabAttempt[]
  sandboxSessions          SandboxSession[]

  @@index([lessonId])
  @@map("lesson_labs")
}

model LessonMistake {
  id              String   @id @default(uuid())
  lessonId        String
  mistake         String
  whyWrong        String
  correctApproach String
  order           Int      @default(0)

  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_mistakes")
}

model LessonRecap {
  id       String   @id @default(uuid())
  lessonId String
  point    String
  order    Int      @default(0)

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_recaps")
}

enum OperatingSystem {
  WINDOWS
  LINUX
  MACOS
  ALL
}

model CommandReference {
  id                 String          @id @default(uuid())
  command            String          @unique
  operatingSystem    OperatingSystem @default(ALL)
  category           String          @default("Network information")
  purpose            String
  syntax             String
  example            String
  expectedOutput     String?
  explanation        String
  warnings           String?
  relatedLessonSlugs Json?           // Array of lesson slug strings
  createdAt          DateTime        @default(now())

  @@map("command_references")
}

model AnonymousLearner {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  progress        UserProgress[]
  quizAttempts    QuizAttempt[]
  labAttempts     LabAttempt[]
  savedLessons    SavedLesson[]
  sandboxSessions SandboxSession[]

  @@map("anonymous_learners")
}

model LabAttempt {
  id                   String            @id @default(uuid())
  userId               String?
  anonymousId          String?
  labId                String
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  commandHistoryJson   Json?             // Array of executed command logs
  validationResultJson Json?             // Validation status, score breakdown, rule checks
  hintsUsedCount       Int               @default(0)
  attemptsCount        Int               @default(1)
  passed               Boolean           @default(false)
  score                Int               @default(0)
  status               String            @default("IN_PROGRESS")
  userSolutionJson     Json?
  createdAt            DateTime          @default(now())

  user                 User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousLearner     AnonymousLearner? @relation(fields: [anonymousId], references: [id], onDelete: Cascade)
  lab                  LessonLab         @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousId])
  @@index([labId])
  @@map("lab_attempts")
}

enum SandboxStatus {
  CREATED
  STARTING
  RUNNING
  STOPPED
  EXPIRED
  FAILED
}

model SandboxSession {
  id                 String            @id @default(uuid())
  userId             String?
  anonymousId        String?
  labId              String?
  status             SandboxStatus     @default(CREATED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  expiresAt          DateTime
  providerType       String            @default("SIMULATED") // SIMULATED | DOCKER
  resourceLimitsJson Json?             // { ramMb: 512, cpuCores: 0.5, timeoutSec: 10 }
  networkStateJson   Json?             // Topology nodes, IP configs, routing tables
  historyJson        Json?             // Executed command logs

  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousLearner   AnonymousLearner? @relation(fields: [anonymousId], references: [id], onDelete: Cascade)
  lab                LessonLab?        @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@index([labId])
  @@index([status])
  @@map("sandbox_sessions")
}

enum CognitiveLevel {
  RECALL
  UNDERSTANDING
  APPLICATION
  TROUBLESHOOTING
  EXPERT_REASONING
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_ANSWER
  TRUE_FALSE
  SCENARIO
  TROUBLESHOOTING
  COMMAND_INTERPRETATION
  PACKET_ANALYSIS
  CONFIGURATION_ANALYSIS
}

model Quiz {
  id           String         @id @default(uuid())
  lessonId     String
  title        String
  passingScore Int            @default(80)
  
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id               String         @id @default(uuid())
  quizId           String
  questionText     String
  optionsJson      Json           // Array of option strings
  correctOption    Int            // Index of correct option
  explanation      String?        // Overall explanation
  explanationsJson Json?          // Optional map of option index to specific explanation string
  cognitiveLevel   CognitiveLevel @default(UNDERSTANDING)
  questionType     QuestionType   @default(MULTIPLE_CHOICE)
  concept          String?        // Target networking concept tag (e.g. "IDS vs IPS", "TCP Handshake")
  difficulty       CourseLevel    @default(BEGINNER)
  points           Int            @default(10)

  quiz             Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id               String            @id @default(uuid())
  userId           String?
  anonymousId      String?
  quizId           String
  score            Int               // Percentage 0-100
  passed           Boolean
  answersJson      Json              // Record of questionId -> selectedOption
  weakConceptsJson Json?             // Array of identified weak concept tags
  attemptNumber    Int               @default(1)
  createdAt        DateTime          @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousLearner AnonymousLearner? @relation(fields: [anonymousId], references: [id], onDelete: Cascade)
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model UserProgress {
  id                 String            @id @default(uuid())
  userId             String?
  anonymousId        String?
  lessonId           String
  started            Boolean           @default(true)
  viewed             Boolean           @default(true)
  practicalCompleted Boolean           @default(false)
  quizAttemptsCount  Int               @default(0)
  completed          Boolean           @default(false)
  score              Int?
  bestScore          Int?
  masteryScore       Int?
  weakConceptsJson   Json?
  completedAt        DateTime?

  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousLearner   AnonymousLearner? @relation(fields: [anonymousId], references: [id], onDelete: Cascade)
  lesson             Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([anonymousId, lessonId])
  @@index([userId])
  @@index([anonymousId])
  @@index([lessonId])
  @@map("user_progress")
}

model Certificate {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  code       String   @unique @default(uuid())
  issuedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model Achievement {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  badgeIcon   String

  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model SimulationState {
  id          String   @id @default(uuid())
  userId      String
  name        String
  topologyJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("simulation_states")
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verifications")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model SavedLesson {
  id               String            @id @default(uuid())
  userId           String?
  anonymousId      String?
  lessonId         String
  createdAt        DateTime          @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousLearner AnonymousLearner? @relation(fields: [anonymousId], references: [id], onDelete: Cascade)
  lesson           Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([anonymousId, lessonId])
  @@index([userId])
  @@index([anonymousId])
  @@map("saved_lessons")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "google" | "github"
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}


