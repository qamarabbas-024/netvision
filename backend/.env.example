# Application Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Secrets
JWT_SECRET=super_secret_netvision_jwt_key_change_in_production
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://netvision:netvision_secret_password@localhost:5432/netvision_db?schema=public

# Redis Service
REDIS_HOST=localhost
REDIS_PORT=6379
