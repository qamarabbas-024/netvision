# ==============================================================================
# NETVISION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER COMMIT ACTUAL PRODUCTION SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# Copy this file to '.env' for local development or configure these variables
# directly in your managed hosting environment (e.g. Railway, Render, Fly.io, AWS).

# ------------------------------------------------------------------------------
# 1. PRODUCTION REQUIRED CONFIGURATION
# ------------------------------------------------------------------------------
# Server HTTP Port
PORT=4000

# Environment mode ('production', 'development', 'test')
NODE_ENV=production

# Global API Router Prefix (default: /api/v1)
API_PREFIX=/api/v1

# Primary Database Connection String (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public

# Secret key used for signing JWT authentication tokens
# MUST be at least 32 characters long in production. DO NOT use default or sample strings.
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS_LONG_CHANGE_THIS

# Token expiration duration (e.g., '7d', '24h')
JWT_EXPIRATION=7d

# CORS Allowed Origin for Web Client (e.g. https://netvision.example.com)
CORS_ORIGIN=https://<YOUR_FRONTEND_DOMAIN>

# Canonical Public API URL (used for callback generation and links)
API_URL=https://<YOUR_API_DOMAIN>

# Canonical Frontend App URL (used for web client redirects)
FRONTEND_URL=https://<YOUR_FRONTEND_DOMAIN>

# Reverse Proxy Trust Configuration ('loopback', '1', '0', or specific proxy CIDR/IP)
# Set to 'loopback' or '1' when behind Cloudflare, AWS ALB, Nginx, Railway, or Render proxy.
TRUSTED_PROXY=loopback


# ------------------------------------------------------------------------------
# 2. OPTIONAL INTEGRATIONS (OAUTH & EMAIL DELIVERY)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client Credentials (Leave blank if Google Login is disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 Client Credentials (Leave blank if GitHub Login is disabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend HTTPS Email API (Required in Production on Render Free)
RESEND_API_KEY=
RESEND_FROM_EMAIL="NetVision <onboarding@resend.dev>"

# Provider selection override (Optional for local testing: 'resend' or 'smtp')
# Default behavior in development: uses SMTP if configured, otherwise DevConsoleFallback.
# Set EMAIL_PROVIDER=resend to explicitly test Resend locally.
EMAIL_PROVIDER=

# SMTP Server Configuration (Optional for local development / self-hosted environments)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NetVision Platform" <no-reply@netvision.edu>
SMTP_REJECT_UNAUTHORIZED=true


# ------------------------------------------------------------------------------
# 3. SEED & DEVELOPMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Controls whether demo/test users (admin@netvision.edu, alex@netvision.edu) are seeded.
# Set to 'true' in development only. Default in production is 'false' (content seed only).
SEED_DEMO_USERS=false

# Passwords for demo users when SEED_DEMO_USERS=true (Must be provided if demo seeding is enabled)
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
