# NetVision Frontend Multi-Stage Production Dockerfile
FROM node:20-alpine AS builder
RUN npm install -g pnpm@11.20.0

WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared ./packages/shared
COPY packages/ui ./packages/ui
COPY packages/simulation-engine ./packages/simulation-engine
COPY frontend ./frontend

# Install dependencies and build shared packages + frontend (fail-closed on error)
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @netvision/shared build
RUN pnpm --filter @netvision/simulation-engine build

WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# Production Runner Stage
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

# Copy workspace structure and Next.js production build
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/frontend/package.json ./frontend/package.json
COPY --from=builder /app/frontend/public ./frontend/public
COPY --from=builder /app/frontend/.next ./frontend/.next
COPY --from=builder /app/frontend/node_modules ./frontend/node_modules

WORKDIR /app/frontend

USER node

EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-p", "3000"]
