{
  "name": "netvision-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NetVision - Learn Networking by Seeing It. Interactive networking learning platform.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter netvision-frontend dev\" \"pnpm --filter netvision-backend dev\"",
    "dev:frontend": "pnpm --filter netvision-frontend dev",
    "dev:backend": "pnpm --filter netvision-backend dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"@netvision/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter netvision-backend test:all",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter netvision-backend prisma:migrate",
    "db:generate": "pnpm --filter netvision-backend prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "networking",
    "education",
    "interactive",
    "visual-learning",
    "packet-tracer",
    "simulation",
    "nextjs",
    "nestjs"
  ],
  "author": "NetVision Team",
  "license": "MIT"
}
