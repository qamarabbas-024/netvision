# ==============================================================================
# NETVISION FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' for local development or configure these variables
# directly in your managed hosting environment (e.g. Vercel, Docker).

# ------------------------------------------------------------------------------
# 1. API & ROUTING CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical Backend REST API base URL
# Local development: http://localhost:4000/api/v1
# Production (Vercel): https://api.netvision.edu/api/v1 or your Render service URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical Public Website URL (used for absolute canonical links and OpenGraph tags)
# Local development: http://localhost:3000
# Production (Vercel): https://netvision.edu or https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js Telemetry Opt-out
NEXT_TELEMETRY_DISABLED=1
